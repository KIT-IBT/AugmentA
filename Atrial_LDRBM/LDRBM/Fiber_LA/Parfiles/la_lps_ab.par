num_gregions = 1

gregion[0].g_et = 1 # when solving a laplacian, all conductivities should be 1
gregion[0].g_el = 1
gregion[0].g_en = 1
gregion[0].g_il = 1
gregion[0].g_it = 1
gregion[0].g_in = 1

experiment = 2 # 2 == laplacian solve.
bidomain = 1 # this option must be set or the code segfaults.  The laplacian solve takes place on the extracellular grid.

#Stimulus setup
num_stim = 4

stim[0].crct.type = 3
#should be lpv

stim[1].ptcl.start = 0
stim[1].ptcl.duration = 1
stim[1].pulse.strength = 2
stim[1].crct.type = 2
# should be rpv

stim[2].ptcl.start = 0
stim[2].ptcl.duration = 1
stim[2].pulse.strength = 1.0
stim[2].crct.type = 2
# should be mv

stim[3].ptcl.start = 0
stim[3].ptcl.duration = 1
stim[3].pulse.strength = -1.0
stim[3].crct.type = 2
# should be ap

cg_maxit_ellip 1000
cg_maxit_parab 1000